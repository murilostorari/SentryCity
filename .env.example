# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_anon_xxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx
SUPABASE_JWT_SECRET=seu_jwt_secret

# Groq API (usado pela análise de notícias)
GROQ_API_KEY=gsk_xxxxx

# Modelo de IA (padrão: qwen/qwen3.8-27b — confirmado funcionando no Groq)
AI_PRODUCT_PROVIDER="groq"
AI_PRODUCT_MODEL="qwen/qwen3.8-27b"
# Outras opções: llama-3.3-70b-versatile, openai/gpt-oss-20b

# Google Maps (opcional)
GOOGLE_MAPS_API_KEY=

# Crawler OSINT (Edge Function secrets — NÃO usar process.env no browser)
# Set via: npx supabase secrets set CRAWLER_RSS_FEEDS="url1,url2,url3"
CRAWLER_RSS_FEEDS=https://g1.globo.com/rss/g1/cidades/,https://g1.globo.com/rss/g1/transito/
JINA_READER_API_KEY=seu_token_opcional
JINA_API_KEY=seu_token_opcional  # usado pelo Jina Search (s.jina.ai) — grátis: 1000 req/dia
